# Copy to .env (gitignored) and set what differs on your machine; everything is optional.
# Scripts read it through scripts/env.sh; unset variables get the defaults shown.

# Hugging Face cache with Qwen/Qwen3.8-27B and the datasets (default: ~/.cache/huggingface)
# HF_HOME=/path/to/huggingface
# HF_HUB_CACHE=/path/to/huggingface/hub

# Run outputs (rollouts, metrics, evals, logs) and the checkpoint store root
# ZROFORM_OUT_ROOT=<repo>/runs
# ZROFORM_DATA=$ZROFORM_OUT_ROOT

# Client venv (tinker SDK + tinker-cookbook; REPRODUCE.md §1) and scratch space
# ZROFORM_CLIENT_VENV=<repo>/.venv-client
# ZROFORM_TMP=$ZROFORM_OUT_ROOT/tmp

# After the model and data are cached: avoids Hub rate limits when many evals start at once
# HF_HUB_OFFLINE=1
# HF_DATASETS_OFFLINE=1
